generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationSource {
  BOOKING
  AIRBNB
  DIRECT
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReservationEventType {
  RESERVATION_CREATED
  DATES_CONFIRMED
  CONTRACT_ACCEPTED
  PAYMENT_RECEIVED
  DEPOSIT_RECEIVED
  DEPOSIT_RETURNED
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  INITIAL_EMAIL_SENT
  INITIAL_EMAIL_FAILED
  FINAL_EMAIL_SENT
  FINAL_EMAIL_FAILED
  CANCELLATION_EMAIL_SENT
  CANCELLATION_EMAIL_FAILED
  FIELD_CHANGED
}

enum GuestEventType {
  NAME_CHANGED
  PHONE_CHANGED
  EMAIL_CHANGED
  UNSUBSCRIBED
}

enum CampaignFilterType {
  ALL
  STAYED_WITHIN_MONTHS
  NOT_STAYED_WITHIN_MONTHS
}

enum CampaignRecipientStatus {
  SENT
  FAILED
}

enum NotificationType {
  CALENDAR_MISMATCH
  PAYMENT_RECEIPT_UPLOADED
  // A guest submitted a note from the check-in page's payment step without attaching any
  // receipt image — see PublicReservationsService.submitPaymentUpdate().
  GUEST_MESSAGE
  // Reported by an ambient-control device (see AmbientEvent) — a sensor threshold rule
  // fired, e.g. repeated loud noise or smoke detected.
  AMBIENT_ALERT
  // An ambient-control device's heartbeat went stale (see AmbientOfflineSchedulerService) —
  // it may be unplugged, tampered with, or lost WiFi.
  DEVICE_OFFLINE
}

model Reservation {
  id                            String             @id @default(uuid())
  guestName                     String
  guestPhone                    String?
  guestEmail                    String?
  checkIn                       DateTime
  checkOut                      DateTime
  paxCount                      Int
  source                        ReservationSource
  externalReference             String?
  totalAmount                   Decimal            @db.Decimal(10, 2)
  currency                      String
  status                        ReservationStatus  @default(PENDING)
  notes                         String?
  confirmationToken             String             @unique @default(uuid())
  datesConfirmedAt              DateTime?
  contractAcceptedAt            DateTime?
  contractAcceptedName          String?
  contractSnapshot              String?
  confirmationPaymentReceivedAt DateTime?
  depositReceivedAt             DateTime?
  depositReturnedAt             DateTime?
  confirmationEmailSentAt       DateTime?
  finalConfirmationEmailSentAt  DateTime?
  cancellationEmailSentAt       DateTime?
  reservationReminderSentAt     DateTime?
  depositReminderSentAt         DateTime?
  events                        ReservationEvent[]
  images                        ReservationImage[]
  notifications                 Notification[]
  missingFromChannelAt          DateTime?
  googleEventId                 String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  guestId String?
  guest   Guest?  @relation(fields: [guestId], references: [id])

  @@unique([source, externalReference])
}

model Settings {
  id                        String    @id
  houseRulesText            String
  paymentInstructions       String
  depositInstructions       String    @default("")
  propertyAddress           String    @default("")
  googleMapsUrl             String    @default("")
  initialEmailTemplate      String    @default("")
  finalEmailTemplate        String    @default("")
  cancellationEmailTemplate String    @default("")
  reservationReminderDaysBefore       Int    @default(3)
  depositReminderDaysAfter            Int    @default(3)
  reservationReminderWhatsappTemplate String @default("Hola {{guestName}}! Te recordamos tu reserva en La Brisa de Mar del Plata del {{checkIn}} al {{checkOut}}. ¡Te esperamos!")
  depositReminderWhatsappTemplate     String @default("Hola {{guestName}}, todavía no registramos el depósito de tu reserva del {{checkIn}}. {{paymentInstructions}}")
  // Rendered server-side and handed back to the Chrome extension so it can pre-fill the
  // Airbnb message compose box — Airbnb guests' real email isn't scrapeable from the host
  // messages page, so this is the primary way they receive the check-in link.
  airbnbMessageTemplate String @default("¡Hola {{guestName}}! Para completar el check-in, por favor completá estos pasos rápidos: {{confirmationUrl}}")
  bankAccountHolder         String    @default("")
  bankCuil                  String    @default("")
  bankAccountNumber         String    @default("")
  bankCbu                   String    @default("")
  bankAlias                 String    @default("")
  bankName                  String    @default("")
  // Either a plain ARS amount (e.g. "210000") or a percentage of the reservation's total
  // (e.g. "30%") — see api/src/settings/fee-value.ts for how this is parsed and resolved.
  confirmationPaymentValue String @default("30%")
  securityDepositValue     String @default("15%")
  confirmationStepText          String @default("¡Todo listo! Completaste todos los pasos necesarios para tu estadía en La Brisa de Mar del Plata.")
  bookingIcalUrl            String?
  airbnbIcalUrl             String?
  // Comma-separated "HH:MM-HH:MM" ranges (24h, Buenos Aires local time, may cross midnight) -
  // a repeated-loud-noise alert only notifies staff when the current time falls inside one of
  // these. Empty means never notify (quiet hours must be explicitly configured) - see
  // api/src/ambient/sound-alert-windows.ts. Smoke/CO alerts are unaffected by this - they're
  // always-on regardless of time.
  soundAlertWindows         String    @default("")
  lastChannelSyncAt         DateTime?
  lastChannelSyncError      String?
  googleRefreshToken        String?
  googleCalendarId          String?
  googleSyncToken           String?
  lastCalendarSyncAt        DateTime?
  lastCalendarSyncError     String?
  updatedAt                 DateTime  @updatedAt
}

model ReservationEvent {
  id            String               @id @default(uuid())
  reservationId String
  reservation   Reservation          @relation(fields: [reservationId], references: [id])
  type          ReservationEventType
  detail        String?
  // Populated only for FIELD_CHANGED events — the field's own name plus its before/after
  // values, alongside the human-readable `detail` string the UI already renders.
  field         String?
  oldValue      String?
  newValue      String?
  // Who made the change: the staff member's email (admin app), "Huésped" (guest check-in),
  // or "Extensión de Chrome" (Booking.com/Airbnb re-scan — the extension has no per-operator
  // identity, just a shared API key). Null for event types that don't carry one.
  actor         String?
  createdAt     DateTime             @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Guest {
  id                 String              @id @default(uuid())
  // Optional: Airbnb's hosting messages page never exposes the guest's email, only their
  // phone — a guest reached that way is still worth a CRM record, keyed on phone instead
  // (see GuestsService.syncFromReservation()). Postgres allows multiple NULLs in a unique
  // column, so this doesn't collide across every email-less guest.
  email              String?             @unique
  name               String
  phone              String?             @unique
  totalStays         Int                 @default(0)
  lastStayAt         DateTime?
  unsubscribedAt     DateTime?
  unsubscribeToken   String              @unique @default(uuid())
  reservations       Reservation[]
  campaignRecipients CampaignRecipient[]
  guestEvents        GuestEvent[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// One row per actual change to a Guest's tracked fields — written only by
// GuestsService.syncFromReservation() (name/phone/email) and
// GuestsService.unsubscribeByToken() (UNSUBSCRIBED), the only two places those
// fields are ever written. Mirrors ReservationEvent's shape exactly.
model GuestEvent {
  id        String         @id @default(uuid())
  guestId   String
  guest     Guest          @relation(fields: [guestId], references: [id])
  type      GuestEventType
  detail    String?
  // Populated for NAME_CHANGED/PHONE_CHANGED/EMAIL_CHANGED — the field's own name plus its
  // before/after values, alongside the human-readable `detail` string the UI already renders.
  field     String?
  oldValue  String?
  newValue  String?
  // Who made the change: the staff member's email (admin app), "Huésped" (guest check-in),
  // or "Extensión de Chrome" (Booking.com/Airbnb re-scan). Null for event types that don't
  // carry one.
  actor     String?
  createdAt DateTime       @default(now())
}

model CampaignTemplate {
  id        String     @id @default(uuid())
  name      String
  subject   String
  bodyHtml  String
  campaigns Campaign[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Campaign {
  id             String              @id @default(uuid())
  templateId     String
  template       CampaignTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  filterType     CampaignFilterType
  filterMonths   Int?
  recipientCount Int
  recipients     CampaignRecipient[]
  sentAt         DateTime            @default(now())
}

model CampaignRecipient {
  id         String                  @id @default(uuid())
  campaignId String
  campaign   Campaign                @relation(fields: [campaignId], references: [id])
  guestId    String
  guest      Guest                   @relation(fields: [guestId], references: [id])
  status     CampaignRecipientStatus
  error      String?
  createdAt  DateTime                @default(now())
}

// A payment/deposit receipt the guest uploaded from the check-in page (Step 3). The file
// itself lives on local disk under UPLOADS_DIR (see api/src/storage/), never in the
// database or a publicly-servable path — these are financial documents, streamed back out
// through an authenticated endpoint (JWT for staff, confirmationToken match for the guest
// re-viewing their own upload) rather than a plain static URL.
model ReservationImage {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  // Filename on disk — a generated uuid + original extension, never the guest's original
  // filename (which could collide or contain unsafe characters). originalName is kept
  // separately, display-only.
  filename      String
  originalName  String?
  mimeType      String
  sizeBytes     Int
  // Optional short note the guest typed alongside this upload (e.g. "es la seña") — shown
  // as a caption wherever the image is displayed. Every image in the same submission shares
  // the same message, since the guest writes one note per batch, not per photo.
  message       String?
  createdAt     DateTime    @default(now())
}

// Not tied to a specific payment (confirmation vs. deposit) at upload time — staff review
// the image(s) and decide which "mark as received" action(s) it corresponds to, same as
// today's manual "guest sent the receipt over WhatsApp" flow, just with the image attached
// to the reservation instead of living only in a chat thread.
model Notification {
  id            String           @id @default(uuid())
  type          NotificationType
  message       String
  reservationId String?
  reservation   Reservation?     @relation(fields: [reservationId], references: [id])
  // Only meaningful for CALENDAR_MISMATCH: identifies "this same blocked-day gap", so a
  // sync run every 30 minutes doesn't create a fresh notification for a gap staff already
  // has an unread alert for. Once that alert is marked read, a still-unresolved gap is
  // free to notify again on the next sync — read is "seen", not "permanently silenced".
  dedupeKey     String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([dedupeKey])
}

// Reported by the Chrome extension (content_script_airbnb.js / background.js) whenever it
// fails to check or submit a reservation. Not linked to Reservation: a failure can happen
// before any reservation exists (e.g. the passive "already loaded?" check on page load, or a
// submit that never reached the point of creating one), unlike ReservationEvent above which
// always has one.
model ExtensionErrorLog {
  id              String   @id @default(uuid())
  source          String
  resId           String?
  operation       String
  message         String
  detail          String?
  url             String
  extensionVersion String?
  createdAt       DateTime @default(now())
}

// Reported by an ambient-control ESP32 device (see /home/smarbos/dev/brisaManager/ambient-control)
// whenever a sensor threshold rule fires. Every report lands here regardless of whether it
// also created a Notification, so this is the full history — Notification (deduped, markable
// read) is the actionable queue built on top of it.
model AmbientEvent {
  id        String   @id @default(uuid())
  deviceId  String
  // Free string, not an enum: new sensor types (smoke, temperature) can be added on the
  // firmware side without an API migration. The admin UI just displays whatever arrives.
  sensor    String
  level     Int?
  message   String
  createdAt DateTime @default(now())

  @@index([deviceId, sensor])
}

// One row per ambient-control device (living room, first floor, ...). Created/updated
// automatically on every heartbeat or alert it sends - there's no separate "register a
// device" step, since a device introduces itself just by talking to the API.
model AmbientDevice {
  id         String                 @id // the device's own deviceId, e.g. "ambient-control-living-room"
  name       String                 @default("")
  lastSeenAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  readings   AmbientDeviceReading[]

  // A one-shot command queued for this device (e.g. "TEST_BUZZER"), delivered by piggybacking
  // it onto the response of the device's next heartbeat POST - the device has no other inbound
  // channel. Cleared by AmbientService.recordHeartbeat the moment it's handed back, so delivery
  // is best-effort/at-most-once, not a durable queue.
  pendingCommand String?
}

// The latest reading for one (device, sensor) pair - overwritten on every heartbeat/alert
// that reports that sensor, so this is "what does it read right now", not a history. See
// AmbientEvent for the full history of threshold-triggered alerts.
model AmbientDeviceReading {
  id        String        @id @default(uuid())
  deviceId  String
  device    AmbientDevice @relation(fields: [deviceId], references: [id])
  sensor    String
  level     Int
  // The device's own calibrated alert threshold for this sensor at the time of the most
  // recent reading (see ambient-control's CALIBRATE_CO/CALIBRATE_SMOKE/CALIBRATE commands) -
  // null for sensors with no threshold concept (temperature, humidity). Lets the UI show a
  // raw ADC reading relative to what actually triggers an alert on this specific device,
  // instead of a bare number with no reference point.
  threshold Int?
  updatedAt DateTime      @updatedAt

  @@unique([deviceId, sensor])
}
