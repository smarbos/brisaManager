generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationSource {
  BOOKING
  AIRBNB
  DIRECT
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReservationEventType {
  RESERVATION_CREATED
  DATES_CONFIRMED
  CONTRACT_ACCEPTED
  PAYMENT_RECEIVED
  DEPOSIT_RECEIVED
  DEPOSIT_RETURNED
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  INITIAL_EMAIL_SENT
  INITIAL_EMAIL_FAILED
  FINAL_EMAIL_SENT
  FINAL_EMAIL_FAILED
  CANCELLATION_EMAIL_SENT
  CANCELLATION_EMAIL_FAILED
}

enum CampaignFilterType {
  ALL
  STAYED_WITHIN_MONTHS
  NOT_STAYED_WITHIN_MONTHS
}

enum CampaignRecipientStatus {
  SENT
  FAILED
}

model Reservation {
  id                            String             @id @default(uuid())
  guestName                     String
  guestPhone                    String?
  guestEmail                    String?
  checkIn                       DateTime
  checkOut                      DateTime
  paxCount                      Int
  source                        ReservationSource
  externalReference             String?
  totalAmount                   Decimal            @db.Decimal(10, 2)
  currency                      String
  status                        ReservationStatus  @default(PENDING)
  notes                         String?
  confirmationToken             String             @unique @default(uuid())
  datesConfirmedAt              DateTime?
  contractAcceptedAt            DateTime?
  contractAcceptedName          String?
  contractSnapshot              String?
  confirmationPaymentReceivedAt DateTime?
  depositReceivedAt             DateTime?
  depositReturnedAt             DateTime?
  confirmationEmailSentAt       DateTime?
  finalConfirmationEmailSentAt  DateTime?
  cancellationEmailSentAt       DateTime?
  reservationReminderSentAt     DateTime?
  depositReminderSentAt         DateTime?
  events                        ReservationEvent[]
  missingFromChannelAt          DateTime?
  googleEventId                 String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  guestId String?
  guest   Guest?  @relation(fields: [guestId], references: [id])

  @@unique([source, externalReference])
}

model Settings {
  id                        String    @id
  houseRulesText            String
  paymentInstructions       String
  depositInstructions       String    @default("")
  propertyAddress           String    @default("")
  googleMapsUrl             String    @default("")
  initialEmailTemplate      String    @default("")
  finalEmailTemplate        String    @default("")
  cancellationEmailTemplate String    @default("")
  reservationReminderDaysBefore       Int    @default(3)
  depositReminderDaysAfter            Int    @default(3)
  reservationReminderWhatsappTemplate String @default("Hola {{guestName}}! Te recordamos tu reserva en La Brisa de Mar del Plata del {{checkIn}} al {{checkOut}}. ¡Te esperamos!")
  depositReminderWhatsappTemplate     String @default("Hola {{guestName}}, todavía no registramos el depósito de tu reserva del {{checkIn}}. {{paymentInstructions}}")
  // Rendered server-side and handed back to the Chrome extension so it can pre-fill the
  // Airbnb message compose box — Airbnb guests' real email isn't scrapeable from the host
  // messages page, so this is the primary way they receive the check-in link.
  airbnbMessageTemplate String @default("¡Hola {{guestName}}! Para completar el check-in, por favor completá estos pasos rápidos: {{confirmationUrl}}")
  bankAccountHolder         String    @default("")
  bankCuil                  String    @default("")
  bankAccountNumber         String    @default("")
  bankCbu                   String    @default("")
  bankAlias                 String    @default("")
  bankName                  String    @default("")
  // Either a plain ARS amount (e.g. "210000") or a percentage of the reservation's total
  // (e.g. "30%") — see api/src/settings/fee-value.ts for how this is parsed and resolved.
  confirmationPaymentValue String @default("30%")
  securityDepositValue     String @default("15%")
  confirmationStepText          String @default("¡Todo listo! Completaste todos los pasos necesarios para tu estadía en La Brisa de Mar del Plata.")
  bookingIcalUrl            String?
  airbnbIcalUrl             String?
  lastChannelSyncAt         DateTime?
  lastChannelSyncError      String?
  googleRefreshToken        String?
  googleCalendarId          String?
  googleSyncToken           String?
  lastCalendarSyncAt        DateTime?
  lastCalendarSyncError     String?
  updatedAt                 DateTime  @updatedAt
}

model ReservationEvent {
  id            String               @id @default(uuid())
  reservationId String
  reservation   Reservation          @relation(fields: [reservationId], references: [id])
  type          ReservationEventType
  detail        String?
  createdAt     DateTime             @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Guest {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  phone              String?
  totalStays         Int                 @default(0)
  lastStayAt         DateTime?
  unsubscribedAt     DateTime?
  unsubscribeToken   String              @unique @default(uuid())
  reservations       Reservation[]
  campaignRecipients CampaignRecipient[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model CampaignTemplate {
  id        String     @id @default(uuid())
  name      String
  subject   String
  bodyHtml  String
  campaigns Campaign[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Campaign {
  id             String              @id @default(uuid())
  templateId     String
  template       CampaignTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  filterType     CampaignFilterType
  filterMonths   Int?
  recipientCount Int
  recipients     CampaignRecipient[]
  sentAt         DateTime            @default(now())
}

model CampaignRecipient {
  id         String                  @id @default(uuid())
  campaignId String
  campaign   Campaign                @relation(fields: [campaignId], references: [id])
  guestId    String
  guest      Guest                   @relation(fields: [guestId], references: [id])
  status     CampaignRecipientStatus
  error      String?
  createdAt  DateTime                @default(now())
}
