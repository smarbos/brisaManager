generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationSource {
  BOOKING
  AIRBNB
  DIRECT
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Reservation {
  id                String            @id @default(uuid())
  guestName         String
  guestPhone        String?
  guestEmail        String?
  checkIn           DateTime
  checkOut          DateTime
  paxCount          Int
  source            ReservationSource
  externalReference String?
  totalAmount       Decimal           @db.Decimal(10, 2)
  currency          String
  status            ReservationStatus @default(PENDING)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
