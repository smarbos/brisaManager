# Postgres
POSTGRES_USER=brisa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=brisa
POSTGRES_PORT=5433

# API
DATABASE_URL=postgresql://brisa:changeme@postgres:5432/brisa?schema=public
JWT_SECRET=changeme-super-secret
JWT_EXPIRES_IN=8h
ADMIN_SEED_EMAIL=admin@labrisa.com.ar
ADMIN_SEED_PASSWORD=changeme
API_PORT=3001
API_ORIGIN=http://localhost:3001
ADMIN_WEB_ORIGIN=http://localhost:5183
GUEST_WEB_ORIGIN=http://localhost:5174

# Frontends
ADMIN_WEB_PORT=5183
GUEST_WEB_PORT=5174
VITE_API_URL=http://localhost:3001
VITE_GUEST_WEB_URL=http://localhost:5174

# Production only
ADMIN_DOMAIN=admin.labrisa.com.ar
GUEST_DOMAIN=reservas.labrisa.com.ar
API_DOMAIN=api.labrisa.com.ar
ACME_EMAIL=admin@labrisa.com.ar

# Email (Resend)
RESEND_API_KEY=re_changeme
EMAIL_FROM=reservas@labrisa.com.ar
ALERT_EMAIL=admin@labrisa.com.ar

# When true, every outbound email (guest confirmations, alerts, marketing) is redirected
# to EMAIL_DEBUG_RECIPIENT instead of its real recipient. Turn off before going to production.
EMAIL_DEBUG_MODE=false
EMAIL_DEBUG_RECIPIENT=you@example.com

# Google Calendar
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/google-calendar/oauth/callback

# Chrome extension (Booking.com extranet reservation sync) — paste this same value into the
# extension's options page as the "Token de acceso". Generate with: openssl rand -hex 24
EXTENSION_API_KEY=changeme
# La Brisa's Booking.com property id, as it appears in the extranet URL's hotel_id param.
# Any import for a different hotel_id is rejected — a mismatch here is either a bug or the
# API key being used against a hotel_id it was never meant for.
BOOKING_HOTEL_ID=9586863
