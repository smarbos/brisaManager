# Postgres
POSTGRES_USER=brisa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=brisa
POSTGRES_PORT=5433

# API
DATABASE_URL=postgresql://brisa:changeme@postgres:5432/brisa?schema=public
JWT_SECRET=changeme-super-secret
JWT_EXPIRES_IN=8h
ADMIN_SEED_EMAIL=admin@labrisa.com.ar
ADMIN_SEED_PASSWORD=changeme
API_PORT=3001
API_ORIGIN=http://localhost:3001
ADMIN_WEB_ORIGIN=http://localhost:5183
GUEST_WEB_ORIGIN=http://localhost:5174

# Frontends
ADMIN_WEB_PORT=5183
GUEST_WEB_PORT=5174
VITE_API_URL=http://localhost:3001
VITE_GUEST_WEB_URL=http://localhost:5174

# Production only
ADMIN_DOMAIN=admin.labrisa.com.ar
GUEST_DOMAIN=reservas.labrisa.com.ar
API_DOMAIN=api.labrisa.com.ar
ACME_EMAIL=admin@labrisa.com.ar

# Email (Resend)
RESEND_API_KEY=re_changeme
EMAIL_FROM=reservas@labrisa.com.ar
ALERT_EMAIL=admin@labrisa.com.ar

# When true, every outbound email (guest confirmations, alerts, marketing) is redirected
# to EMAIL_DEBUG_RECIPIENT instead of its real recipient, and guests can see the property's
# ambient sensor readings on the check-in page regardless of confirmation status or stay
# dates. Turn off before going to production.
DEBUG_MODE=false
# Debug-mode recipient for every email; defaults to damian.mantuano@gmail.com when unset.
EMAIL_DEBUG_RECIPIENT=
# Every email waits this long in the outbox before it's sent (abortable from the admin's
# "Emails" page). Default 300000 (5 minutes).
EMAIL_SEND_DELAY_MS=300000
# Receiving: Resend receives mail for this address (MX record on its domain) and calls
# POST /webhooks/resend; outgoing emails use it as Reply-To, so guest replies come back here.
EMAIL_INBOUND_ADDRESS=
# Staff mailbox received emails are forwarded to, immediately.
EMAIL_FORWARD_TO=
# Signing secret (whsec_...) of the Resend webhook (event: email.received).
RESEND_WEBHOOK_SECRET=

# Google Calendar
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/google-calendar/oauth/callback

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACchangeme
TWILIO_AUTH_TOKEN=changeme
# The Sandbox number while testing (each recipient must first text the Sandbox's join
# code to this number); in production, the approved WhatsApp Business sender number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Meta-approved message templates (Twilio Content SIDs, Content Template Builder). Leave a
# value empty to send that message as freeform text instead — only delivers on the Sandbox
# or within 24h of the guest's last message.
TWILIO_TEMPLATE_CHECKIN_LINK=
TWILIO_TEMPLATE_RESERVATION_REMINDER=
TWILIO_TEMPLATE_DEPOSIT_REMINDER=

# Chrome extension (Booking.com extranet reservation sync) — paste this same value into the
# extension's options page as the "Token de acceso". Generate with: openssl rand -hex 24
EXTENSION_API_KEY=changeme
# La Brisa's Booking.com property id, as it appears in the extranet URL's hotel_id param.
# Any import for a different hotel_id is rejected — a mismatch here is either a bug or the
# API key being used against a hotel_id it was never meant for.
BOOKING_HOTEL_ID=9586863

# ambient-control ESP32 device(s) — paste this same value into the device's secrets.h as
# AMBIENT_API_KEY. Generate with: openssl rand -hex 24
AMBIENT_API_KEY=changeme

# Guest identity documents (api/src/guest-documents). Two DISTINCT 32-byte keys, 64 hex chars
# each — generate each with: openssl rand -hex 32. The API refuses to boot without them.
# Keep both in the password manager: losing DOCUMENT_ENCRYPTION_KEY makes every stored
# document number permanently unreadable.
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_HASH_KEY=
