#pragma once

// Copy this file to secrets.h (gitignored - see .gitignore) and fill in real values before
// building. main.cpp includes secrets.h.
struct WifiNetwork {
  const char* ssid;
  const char* password;
};

// Every network this device may join, in priority order - e.g. the apartment's and the lab's,
// so the same build works in both places. At boot each is tried in turn until one connects;
// while disconnected, each background retry moves on to the next one (see maintainWiFi()).
constexpr WifiNetwork WIFI_NETWORKS[] = {
    {"your-apartment-wifi-ssid", "your-apartment-wifi-password"},
    {"your-lab-wifi-ssid", "your-lab-wifi-password"},
};
// Must match AMBIENT_API_KEY in the PRODUCTION server's .env (the device talks to
// api.labrisa.com.ar, not a local dev stack) - generate a fresh one with:
// openssl rand -hex 24
constexpr const char* AMBIENT_API_KEY = "your-ambient-api-key";
